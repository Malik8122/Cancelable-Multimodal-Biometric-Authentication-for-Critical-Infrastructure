# Copy to .env.local to override. Defaults to http://127.0.0.1:8000, matching
# `uvicorn backend.main:app --reload`'s default bind address (see
# docs/BACKEND_API.md). The backend's CORS_ALLOWED_ORIGINS must include this
# dev server's own origin (defaults to http://localhost:5173) or the browser
# will block every request.
VITE_API_BASE_URL=http://127.0.0.1:8000
