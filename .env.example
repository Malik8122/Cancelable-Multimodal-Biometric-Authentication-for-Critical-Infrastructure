# Copy this file to `.env` (which is gitignored) and fill in real values.
# Never commit a real .env - MASTER_SECRET protects every enrolled user's
# biometric templates.

# Generate a real secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
MASTER_SECRET=replace-with-a-real-secret-you-generated-yourself

# Optional - defaults shown. See backend/config.py for the full list and
# what each one does.
# DATABASE_URL=sqlite:///./biometric.db
# APPLICATION_ID=capstone-demo
# FACE_MODEL_PATH=models/face/saved/face_embedder.pt
# IRIS_MODEL_PATH=models/iris/saved/iris_embedder.pt
# FINGERPRINT_MODEL_PATH=models/fingerprint/saved/fingerprint_embedder.pt
# VOICE_MODEL_PATH=models/voice/saved/voice_embedder.pt
# TEMPLATE_BITS=128
# MATCH_THRESHOLD=0.9

# Comma-separated origins the Phase 3A dashboard (Vite dev server, by
# default http://localhost:5173) is allowed to call this API from. Read
# directly by backend/main.py, not via Settings - see that file's
# _resolve_cors_origins() docstring for why. Never set this to "*".
# CORS_ALLOWED_ORIGINS=http://localhost:5173
